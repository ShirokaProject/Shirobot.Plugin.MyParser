<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyParser.Provider.BiliBili.Views"
             x:Class="MyParser.Provider.BiliBili.Views.BiliCommentCard"
             x:DataType="vm:BiliCommentCardViewModel"
             Width="720"
             Height="{Binding CanvasHeight}">
    <Design.DataContext>
        <vm:BiliCommentCardViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="Border.PremiumCard">
            <Setter Property="BoxShadow" Value="0 8 24 0 #1A000000" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardFallbackBg">#FFF7FA</SolidColorBrush>
                    <SolidColorBrush x:Key="CardTextPrimary">#18191C</SolidColorBrush>
                    <SolidColorBrush x:Key="CardTextSecondary">#3A3D42</SolidColorBrush>
                    <SolidColorBrush x:Key="CardTextMuted">#61666D</SolidColorBrush>
                    <SolidColorBrush x:Key="CardPanelBg">#E6FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="CardPanelBorder">#2218191C</SolidColorBrush>
                    <SolidColorBrush x:Key="CardImageOverlay">#A6FFF7FA</SolidColorBrush>
                    <SolidColorBrush x:Key="CommentSurface">#F8FFFFFF</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardFallbackBg">#18191C</SolidColorBrush>
                    <SolidColorBrush x:Key="CardTextPrimary">#F1F2F3</SolidColorBrush>
                    <SolidColorBrush x:Key="CardTextSecondary">#D6D9DC</SolidColorBrush>
                    <SolidColorBrush x:Key="CardTextMuted">#A2A7AE</SolidColorBrush>
                    <SolidColorBrush x:Key="CardPanelBg">#B3212326</SolidColorBrush>
                    <SolidColorBrush x:Key="CardPanelBorder">#2EFFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="CardImageOverlay">#D918191C</SolidColorBrush>
                    <SolidColorBrush x:Key="CommentSurface">#D9242628</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Classes="PremiumCard"
            Width="720"
            Height="{Binding CanvasHeight}"
            CornerRadius="10"
            ClipToBounds="True"
            Background="{DynamicResource CardFallbackBg}">
        <Grid>
            <Border Margin="-48">
                <Border.Effect>
                    <BlurEffect Radius="32" />
                </Border.Effect>
                <Border.Background>
                    <ImageBrush Source="{Binding Cover}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <Border Background="{DynamicResource CardImageOverlay}" />

            <StackPanel Margin="48,44" Spacing="22">
                <Border CornerRadius="18"
                        Background="{DynamicResource CardPanelBg}"
                        BorderBrush="{DynamicResource CardPanelBorder}"
                        BorderThickness="1"
                        Padding="22,20">
                    <StackPanel Spacing="18">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Grid Width="52" Height="52" Margin="0,0,14,0">
                                <Border CornerRadius="26" ClipToBounds="True" BorderBrush="#FB7299" BorderThickness="2">
                                    <Image Source="{Binding AuthorAvatar}" Stretch="UniformToFill" />
                                </Border>
                                <Border Background="#FB7299" Width="18" Height="18" CornerRadius="9"
                                        BorderBrush="#18191C" BorderThickness="1"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2">
                                    <TextBlock Text="UP" FontSize="7" Foreground="White" FontWeight="Black"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                <TextBlock Text="{Binding AuthorName}" Foreground="{DynamicResource CardTextPrimary}" FontSize="18" FontWeight="Bold" />
                                <TextBlock Text="{Binding MetaText}" Foreground="{DynamicResource CardTextMuted}" FontSize="12" FontWeight="Medium" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="#FB7299" CornerRadius="9" Padding="11,6" VerticalAlignment="Center">
                                <TextBlock Text="Bilibili 评论区" Foreground="White" FontSize="12" FontWeight="Black" />
                            </Border>
                        </Grid>

                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource CardTextPrimary}"
                                   FontSize="26" FontWeight="Heavy"
                                   TextWrapping="Wrap" LineHeight="34" />

                        <Border Background="#1800AEEC" BorderBrush="#4000AEEC" BorderThickness="1" CornerRadius="10" Padding="12,9">
                            <TextBlock Text="{Binding StatsText}" Foreground="{DynamicResource CardTextSecondary}"
                                       FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Comments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:BiliCommentItemViewModel">
                            <Border Margin="0,0,0,14"
                                    CornerRadius="16"
                                    Background="{DynamicResource CommentSurface}"
                                    BorderBrush="{DynamicResource CardPanelBorder}"
                                    BorderThickness="1"
                                    Padding="20,18">
                                <Grid ColumnDefinitions="58,*" RowDefinitions="Auto,Auto,Auto">
                                    <Border Width="46" Height="46" CornerRadius="23"
                                            BorderBrush="#66FB7299" BorderThickness="1.5"
                                            Background="{DynamicResource CardPanelBg}"
                                            ClipToBounds="True">
                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                    </Border>

                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding UserName}" Foreground="{DynamicResource CardTextPrimary}"
                                                           FontSize="16" FontWeight="Bold" />
                                                <Border IsVisible="{Binding IsAuthor}" Background="#FB7299" CornerRadius="6" Padding="7,2">
                                                    <TextBlock Text="UP主" Foreground="White" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding UserIdText}" Foreground="{DynamicResource CardTextMuted}" FontSize="11" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Background="#1400AEEC" BorderBrush="#4000AEEC"
                                                BorderThickness="1" CornerRadius="8" Padding="9,4" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding IndexText}" Foreground="#00AEEC" FontSize="11" FontWeight="Bold" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,14,0,0" Spacing="12">
                                        <TextBlock Text="{Binding Message}" Foreground="{DynamicResource CardTextSecondary}"
                                                   FontSize="15" LineHeight="23" TextWrapping="Wrap" MaxLines="12" />
                                        <Border IsVisible="{Binding HasImage}" CornerRadius="12" ClipToBounds="True"
                                                Background="#18191C" BorderBrush="{DynamicResource CardPanelBorder}"
                                                BorderThickness="1" Height="260">
                                            <Image Source="{Binding Image}" Stretch="Uniform" />
                                        </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="2" Grid.Column="1" Margin="0,14,0,0" ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding MetaText}" Foreground="{DynamicResource CardTextMuted}" FontSize="11" />
                                        <TextBlock Grid.Column="1" Text="{Binding StatsText}" Foreground="{DynamicResource CardTextMuted}"
                                                   FontSize="11" FontWeight="SemiBold" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
