<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyParser.Provider.BiliBili.Views"
             xmlns:cr="using:Shirobot.Plugin.MyParser.CardRendering"
             x:Class="MyParser.Provider.BiliBili.Views.BiliArticleDocument"
             x:DataType="vm:BiliArticleDocumentViewModel"
             Width="640"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

    <Design.DataContext>
        <vm:BiliArticleDocumentViewModel />
    </Design.DataContext>

    <!-- 阅读排版：正文宽 560；字号 28 标题 / 17–22 小标题 / 16 正文 / 12 说明。
         视觉与 B 站视频卡片一致：樱花粉 → 天蓝渐变、小电视角标、头像框、毛玻璃数据栏 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Page" Color="#F5F6F8" />
                    <SolidColorBrush x:Key="Placeholder" Color="#E9ECF1" />
                    <SolidColorBrush x:Key="TextTitle" Color="#16181D" />
                    <SolidColorBrush x:Key="TextBody" Color="#2E3138" />
                    <SolidColorBrush x:Key="TextMeta" Color="#6B6F79" />
                    <SolidColorBrush x:Key="TagText" Color="#363941" />
                    <SolidColorBrush x:Key="PanelBg" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="PanelBorder" Color="#0D101828" />
                    <SolidColorBrush x:Key="MetricLabel" Color="#6B6F79" />
                    <SolidColorBrush x:Key="MetricNumber" Color="#16181D" />
                    <SolidColorBrush x:Key="BrandText" Color="#8C909A" />
                    <SolidColorBrush x:Key="AvatarGap" Color="#F5F6F8" />
                    <LinearGradientBrush x:Key="CoverFade" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#00F5F6F8" Offset="0.45" />
                        <GradientStop Color="#FFF5F6F8" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Page" Color="#22242B" />
                    <SolidColorBrush x:Key="Placeholder" Color="#2D3038" />
                    <SolidColorBrush x:Key="TextTitle" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="TextBody" Color="#D9DBE0" />
                    <SolidColorBrush x:Key="TextMeta" Color="#A3A7B0" />
                    <SolidColorBrush x:Key="TagText" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="PanelBg" Color="#17FFFFFF" />
                    <SolidColorBrush x:Key="PanelBorder" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="MetricLabel" Color="#B3B7C0" />
                    <SolidColorBrush x:Key="MetricNumber" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="BrandText" Color="#8F939C" />
                    <SolidColorBrush x:Key="AvatarGap" Color="#22242B" />
                    <LinearGradientBrush x:Key="CoverFade" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#0022242B" Offset="0.45" />
                        <GradientStop Color="#FF22242B" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.glass">
            <Setter Property="Background" Value="#570B0D12" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="BackdropEffect">
                <BlurEffect Radius="16" />
            </Setter>
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Page}">
        <Grid>
            <!-- 整页铺一层很淡的平台双色调，与视频卡片的色调呼应 -->
            <Border Background="{Binding AccentSoftGradient}" Opacity="0.6" />

            <StackPanel>
                <!-- ===== 头图：向下淡入页面底色，没有分界线 ===== -->
                <Grid Height="240" ClipToBounds="True" IsVisible="{Binding HasCover}">
                    <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                    <Border Background="{DynamicResource CoverFade}" />
                    <!-- 角标：与视频卡片同款毛玻璃胶囊 -->
                    <Border Classes="glass" Padding="3,3,11,3" Margin="16,16,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Border Width="20" Height="20" CornerRadius="10" Background="#FFFFFF">
                                <Viewbox Width="12" Height="12">
                                    <Path Fill="#00AEEC" Width="24" Height="24"
                                          Data="{Binding Source={x:Static cr:MediaCardIcons.BilibiliTv}, Converter={x:Static cr:MediaCardGeometryConverter.Instance}}" />
                                </Viewbox>
                            </Border>
                            <TextBlock Text="哔哩哔哩" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Width="1" Height="10" Background="#66FFFFFF" VerticalAlignment="Center" Margin="2,0" />
                            <TextBlock Text="{Binding KindText}" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Margin="40,0,40,0" Spacing="16">
                    <!-- 没有头图时，平台标识放在正文顶部 -->
                    <StackPanel Orientation="Horizontal" Spacing="7" Margin="0,30,0,0" IsVisible="{Binding !HasCover}">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{Binding AccentGradient}">
                            <Viewbox Width="13" Height="13">
                                <Path Fill="#FFFFFF" Width="24" Height="24"
                                      Data="{Binding Source={x:Static cr:MediaCardIcons.BilibiliTv}, Converter={x:Static cr:MediaCardGeometryConverter.Instance}}" />
                            </Viewbox>
                        </Border>
                        <TextBlock Text="哔哩哔哩" Foreground="{DynamicResource TextBody}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="·" Foreground="{DynamicResource TextMeta}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource TextMeta}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextTitle}" FontSize="28" FontWeight="Bold"
                               LineHeight="38" TextWrapping="Wrap" />

                    <!-- 作者：与视频卡片一致，不加描边；佩戴了头像框就按头像 1.75 倍叠上去 -->
                    <Grid ColumnDefinitions="Auto,*" Margin="{Binding AuthorRowMargin}">
                        <Ellipse Width="{Binding AvatarSize}" Height="{Binding AvatarSize}" IsVisible="{Binding HasAvatar}">
                            <Ellipse.Fill>
                                <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="{Binding AvatarSize}" Height="{Binding AvatarSize}" IsVisible="{Binding !HasAvatar}" Fill="{Binding AccentSoftGradient}" />
                        <TextBlock Text="{Binding AvatarInitial}" IsVisible="{Binding !HasAvatar}" Foreground="{Binding PrimaryBrush}"
                                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image Source="{Binding AvatarPendant}" IsVisible="{Binding HasAvatarPendant}"
                               Width="{Binding PendantSize}" Height="{Binding PendantSize}" Margin="{Binding PendantMargin}" Stretch="Uniform" />
                        <StackPanel Grid.Column="1" Margin="{Binding AuthorTextMargin}" VerticalAlignment="Center" Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding AuthorName}" Foreground="{DynamicResource TextTitle}" FontSize="14" FontWeight="Bold" />
                                <TextBlock Text="{Binding AuthorMeta}" Foreground="{DynamicResource TextMeta}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding MetaText}" Foreground="{DynamicResource TextMeta}" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- 分类：平台浅渐变 -->
                    <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}" Margin="0,-4,0,-6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Background="{Binding $parent[UserControl].((vm:BiliArticleDocumentViewModel)DataContext).AccentSoftGradient}"
                                        CornerRadius="8" Padding="10,4" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TagText}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="1.5" CornerRadius="1" Background="{Binding AccentLineGradient}" />

                    <!-- ===== 正文 ===== -->
                    <ItemsControl ItemsSource="{Binding Blocks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="14" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BiliArticleBlockViewModel">
                                <Panel>
                                    <TextBlock IsVisible="{Binding IsParagraph}" Text="{Binding Text}" Foreground="{DynamicResource TextBody}"
                                               FontSize="16" LineHeight="28" TextWrapping="Wrap" />

                                    <!-- 小标题：左侧渐变短条 -->
                                    <Grid IsVisible="{Binding IsHeading}" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                                        <Border Width="4" CornerRadius="2" Margin="0,4,10,4"
                                                Background="{Binding $parent[UserControl].((vm:BiliArticleDocumentViewModel)DataContext).AccentGradient}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource TextTitle}"
                                                   FontSize="{Binding HeadingSize}" FontWeight="Bold" LineHeight="30" TextWrapping="Wrap" />
                                    </Grid>

                                    <!-- 引用：浅渐变底 + 渐变左边线 -->
                                    <Border IsVisible="{Binding IsQuote}" CornerRadius="8" ClipToBounds="True"
                                            Background="{Binding $parent[UserControl].((vm:BiliArticleDocumentViewModel)DataContext).AccentSoftGradient}">
                                        <Grid ColumnDefinitions="3,*">
                                            <Border Background="{Binding $parent[UserControl].((vm:BiliArticleDocumentViewModel)DataContext).AccentGradient}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource TextBody}" FontSize="15"
                                                       LineHeight="25" TextWrapping="Wrap" Margin="13,10,14,10" />
                                        </Grid>
                                    </Border>

                                    <!-- 图片 -->
                                    <StackPanel IsVisible="{Binding IsImage}" Spacing="6">
                                        <Border CornerRadius="8" ClipToBounds="True" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                                HorizontalAlignment="Center" Background="{DynamicResource Placeholder}">
                                            <Panel>
                                                <!-- 竖图：同一张图模糊放大铺满背景，再压一层暗色，原图完整居中 -->
                                                <Image Source="{Binding Image}" Stretch="UniformToFill" IsVisible="{Binding HasBackdrop}" Margin="-24">
                                                    <Image.Effect>
                                                        <BlurEffect Radius="70" />
                                                    </Image.Effect>
                                                </Image>
                                                <Border Background="#4D000000" IsVisible="{Binding HasBackdrop}" />
                                                <Image Source="{Binding Image}" Stretch="Uniform" />
                                            </Panel>
                                        </Border>
                                        <TextBlock IsVisible="{Binding HasCaption}" Text="{Binding Caption}" Foreground="{DynamicResource TextMeta}"
                                                   FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== 数据栏：与视频卡片同款毛玻璃面板，图标用平台渐变 ===== -->
                <Border IsVisible="{Binding HasMetrics}" Margin="40,26,40,0" Background="{DynamicResource PanelBg}"
                        BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="14" Padding="6,12">
                    <ItemsControl ItemsSource="{Binding Metrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="cr:MediaCardMetric">
                                <StackPanel Spacing="3" HorizontalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                        <Path Data="{Binding Icon, Converter={x:Static cr:MediaCardGeometryConverter.Instance}}"
                                              Fill="{Binding $parent[UserControl].((vm:BiliArticleDocumentViewModel)DataContext).AccentGradient}"
                                              Stretch="Uniform" Width="12" Height="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" Foreground="{DynamicResource MetricLabel}"
                                                   FontSize="11" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Value}" Foreground="{DynamicResource MetricNumber}"
                                               FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <cr:CardBrandMark TextSize="10" Opacity="0.8" Margin="40,14,40,18"
                                  TextElement.Foreground="{DynamicResource BrandText}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
