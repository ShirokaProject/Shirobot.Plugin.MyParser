<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:MyParser.Provider.Douyin.Views"
             x:Class="MyParser.Provider.Douyin.Views.DouyinCommentCard"
             x:DataType="views:DouyinCommentCardViewModel"
             Width="720"
             Height="{Binding CanvasHeight}"
             Background="#F4F6FA">
    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBackground">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="Divider">#E9EDF3</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimary">#273449</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondary">#8995A8</SolidColorBrush>
        <SolidColorBrush x:Key="DouyinRed">#F36C86</SolidColorBrush>
        <SolidColorBrush x:Key="ReplyBlue">#7186A8</SolidColorBrush>
    </UserControl.Resources>

    <Border Margin="8"
            Background="{StaticResource CardBackground}"
            BorderBrush="#E8ECF2"
            BorderThickness="1"
            CornerRadius="20"
            ClipToBounds="True">
        <StackPanel Margin="18,8,18,10" Spacing="0">
            <Grid Height="52" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Border Width="4" Height="20" CornerRadius="2" Background="{StaticResource DouyinRed}" />
                <TextBlock Grid.Column="1"
                           Text="评论区"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="18"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        Background="#F4F6FA"
                        CornerRadius="10"
                        Padding="10,5"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding CommentCountText}"
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="11"
                               FontWeight="SemiBold" />
                </Border>
            </Grid>

            <TextBlock Text="{Binding SourceTitle}"
                       Foreground="{StaticResource TextSecondary}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"
                       Margin="14,0,14,5" />

            <ItemsControl ItemsSource="{Binding Comments}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="views:DouyinCommentItemViewModel">
                        <Border Padding="10,11,10,10"
                                BorderBrush="{StaticResource Divider}"
                                BorderThickness="0,1,0,0">
                            <Grid ColumnDefinitions="44,*" ColumnSpacing="8">
                                <Border Width="40" Height="40"
                                        CornerRadius="20"
                                        Background="#E9EDF3"
                                        ClipToBounds="True"
                                        VerticalAlignment="Top">
                                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="0">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding UserName}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       MaxWidth="340"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border IsVisible="{Binding IsAuthor}"
                                                    Background="#FFF0F4"
                                                    CornerRadius="7"
                                                    Padding="6,2"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="作者"
                                                           Foreground="{StaticResource DouyinRed}"
                                                           FontSize="9"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="⋮"
                                                   Foreground="#71809A"
                                                   FontSize="19"
                                                   LineHeight="18"
                                                   VerticalAlignment="Top" />
                                    </Grid>

                                    <TextBlock Text="{Binding TimeLocationText}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="10"
                                               Margin="0,2,0,6" />

                                    <TextBlock Text="{Binding Message}"
                                               Foreground="#354259"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap" />

                                    <Border IsVisible="{Binding HasImage}"
                                            Width="210"
                                            Height="132"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"
                                            CornerRadius="9"
                                            ClipToBounds="True"
                                            Background="#F3F5F8">
                                        <Image Source="{Binding CommentImage}" Stretch="UniformToFill" />
                                    </Border>

                                    <Border IsVisible="{Binding HasReplies}"
                                            Background="#F4F6FA"
                                            CornerRadius="8"
                                            Padding="10,8"
                                            Margin="0,8,0,0">
                                        <TextBlock Text="{Binding ReplyCountText}"
                                                   Foreground="#647793"
                                                   FontSize="11" />
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Spacing="22" Margin="0,8,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="♡" Foreground="#75839A" FontSize="17" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding LikeText}"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="↶" Foreground="#75839A" FontSize="15" VerticalAlignment="Center" />
                                            <TextBlock Text="回复"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontSize="10"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>
