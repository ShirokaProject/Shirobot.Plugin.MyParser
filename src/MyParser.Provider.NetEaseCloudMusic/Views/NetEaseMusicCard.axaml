<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyParser.Provider.NetEaseCloudMusic.Views"
             x:Class="MyParser.Provider.NetEaseCloudMusic.Views.NetEaseMusicCard"
             x:DataType="vm:NetEaseMusicCardViewModel" Width="320">
    <Design.DataContext>
        <vm:NetEaseMusicCardViewModel Title="电波妄想美少女Q" Artists="格瑞普喵" Album="MuseDash 特别集"
            LyricText="妄想のステップ刻んで、キミのハートにフルコン...&#10;響けメロディ、夜空を突き抜けて走る光の波…&#10;指先が紡ぐ奇跡、誰も止められない感情線。&#10;夢のステージへ、もう一度手を伸ばして——&#10;示例歌词第五行，跟着节奏向前。&#10;示例歌词第六行，让旋律继续回响。&#10;示例歌词第七行，记录此刻的心情。&#10;示例歌词第八行，追寻远方的光。&#10;示例歌词第九行，再次唱起这首歌。&#10;示例歌词第十行，继续随旋律前行。&#10;示例歌词第十一行，听见熟悉的节拍。&#10;示例歌词第十二行，记住这一刻的声音。&#10;示例歌词第十三行，让歌声延续。&#10;示例歌词第十四行，走向下一段旋律。&#10;示例歌词第十五行，预览到这里结束。" />
    </Design.DataContext>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBg" Color="#E9ECEF" />
                    <SolidColorBrush x:Key="TextTitle" Color="#1D1B20" />
                    <SolidColorBrush x:Key="TextMeta" Color="#49454F" />
                    <SolidColorBrush x:Key="TextDesc" Color="#49454F" />
                    <SolidColorBrush x:Key="AvatarBorder" Color="#CAC4D0" />
                    <SolidColorBrush x:Key="BrandText" Color="#79747E" />
                    <SolidColorBrush x:Key="CardOverlay" Color="#E6E9ECEF" />
                    <SolidColorBrush x:Key="Divider" Color="#251D1B20" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBg" Color="#343A40" />
                    <SolidColorBrush x:Key="TextTitle" Color="#F3EEF6" />
                    <SolidColorBrush x:Key="TextMeta" Color="#C9C4D0" />
                    <SolidColorBrush x:Key="TextDesc" Color="#C9C4D0" />
                    <SolidColorBrush x:Key="AvatarBorder" Color="#49454F" />
                    <SolidColorBrush x:Key="BrandText" Color="#938F99" />
                    <SolidColorBrush x:Key="CardOverlay" Color="#E6343A40" />
                    <SolidColorBrush x:Key="Divider" Color="#25FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border CornerRadius="8" ClipToBounds="True" Background="{DynamicResource CardBg}">
        <Grid>
            <Grid IsHitTestVisible="False" ClipToBounds="True">
                <Border Margin="-28">
                    <Border.Background><ImageBrush Source="{Binding Cover}" Stretch="UniformToFill" /></Border.Background>
                    <Border.Effect><BlurEffect Radius="24" /></Border.Effect>
                </Border>
                <Border Background="{DynamicResource CardOverlay}" />
            </Grid>
            <StackPanel Margin="14,14,14,12" Spacing="11">
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="5">
                    <Border Width="52" Height="52" CornerRadius="10" ClipToBounds="True"
                            BorderBrush="{DynamicResource AvatarBorder}" BorderThickness="1.2" Margin="0,0,10,-2">
                        <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextTitle}" FontSize="15"
                                   FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Foreground="{DynamicResource TextMeta}" FontSize="10"
                                   Opacity="0.7"
                                   FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- Remix Icon: netease-cloud-music-line -->
                    <Border Grid.Column="2" Width="40" Height="28" Margin="8,0,2,0"
                            CornerRadius="14" Background="#18FF3B5C" VerticalAlignment="Center">
                        <Path Width="20" Height="20" HorizontalAlignment="Center"
                              VerticalAlignment="Center" Fill="#FF3B5C" Stretch="Uniform"
                              Data="M10.4222 11.375C10.1278 12.4026 10.4341 13.4395 11.2058 14.0282C12.267 14.8376 13.7712 14.3289 14.0796 13.0331C14.1599 12.6958 14.1833 12.311 14.1067 11.9767C13.8775 10.9756 13.586 9.98862 13.3147 8.98094C11.9843 9.13543 10.7722 10.1533 10.4222 11.375ZM15.9698 11.0879C16.2427 12.1002 16.2553 13.1053 15.8435 14.0875C14.7148 16.7784 11.1215 17.2286 9.26951 14.9136C7.96829 13.2869 7.99065 10.953 9.32982 9.18031C10.1096 8.14796 11.1339 7.47322 12.3776 7.12595C12.5007 7.09159 12.6241 7.058 12.7566 7.02157C12.6731 6.60736 12.569 6.20612 12.5143 5.79828C12.3375 4.48137 13.026 3.29477 14.2582 2.7574C15.4836 2.22294 16.9661 2.54204 17.7889 3.51738C18.1936 3.99703 18.183 4.59854 17.7631 4.98218C17.3507 5.359 16.7665 5.32761 16.3276 4.89118C16.0809 4.64585 15.8185 4.45112 15.451 4.45569C14.9264 4.46223 14.4642 4.87382 14.5058 5.39329C14.5432 5.86105 14.6785 6.32376 14.8058 6.77892C14.8276 6.85679 15.0218 6.91415 15.1436 6.9321C16.4775 7.12862 17.6476 7.66332 18.6165 8.60769C21.1739 11.1006 21.4772 15.1394 19.2882 18.0482C17.7593 20.0797 15.6785 21.2165 13.1609 21.4567C8.53953 21.8977 4.49683 18.9278 3.46188 14.3992C2.5147 10.2551 4.8397 5.83074 8.79509 4.25032C9.38067 4.01635 9.93787 4.21869 10.1664 4.74827C10.3982 5.28546 10.147 5.83389 9.55552 6.09847C7.18759 7.15787 5.73935 8.9527 5.34076 11.5215C4.80806 14.9546 6.99662 18.2982 10.3416 19.2428C13.0644 20.0117 15.9994 19.0758 17.6494 16.9123C19.2354 14.8328 19.0484 11.8131 17.2221 10.0389C16.7172 9.54838 16.1246 9.21455 15.3988 9.02564C15.5974 9.74151 15.7879 10.4136 15.9698 11.0879Z" />
                    </Border>
                </Grid>
                <Border Width="40" Height="4" CornerRadius="2"
                        Background="{DynamicResource Divider}"
                        HorizontalAlignment="Center" IsHitTestVisible="False" />
                <Border ClipToBounds="True" IsVisible="{Binding HasLyrics}" Margin="8,0,8,0">
                    <Border.OpacityMask>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#FFFFFFFF" Offset="0.6" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.OpacityMask>
                    <TextBlock Text="{Binding LyricText}" Foreground="{DynamicResource TextDesc}" FontSize="12"
                               FontStyle="Italic" TextWrapping="Wrap" LineHeight="20" MaxLines="15"
                               TextTrimming="CharacterEllipsis" Margin="2,0" />
                </Border>
                <TextBlock Text="无歌词" IsVisible="{Binding !HasLyrics}" Foreground="{DynamicResource TextDesc}"
                           FontSize="12" LineHeight="20" TextAlignment="Center" Margin="2,12,2,14" />
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center" Margin="2,0">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Path Data="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"
                                  Fill="#FF3B5C" Stretch="Uniform" Width="8" Height="8" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SourceText}" Foreground="{DynamicResource BrandText}" FontSize="9" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Margin="0 0 0 0" Grid.Column="2" Text="{Binding BrandText}" Foreground="{DynamicResource BrandText}"
                               FontSize="7" Opacity="0.8" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
