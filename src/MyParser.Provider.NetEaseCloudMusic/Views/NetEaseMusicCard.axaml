<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyParser.Provider.NetEaseCloudMusic.Views"
             xmlns:card="using:Shirobot.Plugin.MyParser.CardRendering"
             x:Class="MyParser.Provider.NetEaseCloudMusic.Views.NetEaseMusicCard"
             x:DataType="vm:NetEaseMusicCardViewModel"
             Width="320"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Design.DataContext>
        <vm:NetEaseMusicCardViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CardBase" Color="#F5F6F8" />
                    <LinearGradientBrush x:Key="AmbientVeil" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#94FFFFFF" Offset="0" />
                        <GradientStop Color="#CCFFFFFF" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PanelBg" Color="#A3FFFFFF" />
                    <SolidColorBrush x:Key="PanelBorder" Color="#0D101828" />
                    <SolidColorBrush x:Key="TextTitle" Color="#16181D" />
                    <SolidColorBrush x:Key="TextArtist" Color="#363941" />
                    <SolidColorBrush x:Key="TextMeta" Color="#6B6F79" />
                    <SolidColorBrush x:Key="TextLyric" Color="#25282F" />
                    <SolidColorBrush x:Key="TextTranslation" Color="#7D818B" />
                    <SolidColorBrush x:Key="BrandText" Color="#8C909A" />
                    <SolidColorBrush x:Key="CoverEmpty" Color="#E6E8EC" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CardBase" Color="#22242B" />
                    <LinearGradientBrush x:Key="AmbientVeil" StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#80181A20" Offset="0" />
                        <GradientStop Color="#BD181A20" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="PanelBg" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="PanelBorder" Color="#1AFFFFFF" />
                    <SolidColorBrush x:Key="TextTitle" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="TextArtist" Color="#D9DBE0" />
                    <SolidColorBrush x:Key="TextMeta" Color="#A6AAB3" />
                    <SolidColorBrush x:Key="TextLyric" Color="#E6E8EC" />
                    <SolidColorBrush x:Key="TextTranslation" Color="#AEB2BB" />
                    <SolidColorBrush x:Key="BrandText" Color="#8F939C" />
                    <SolidColorBrush x:Key="CoverEmpty" Color="#3A3D45" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Border.glassPanel">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="BackdropEffect">
                <BlurEffect Radius="16" />
            </Setter>
        </Style>
    </UserControl.Styles>

    <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource CardBase}">
        <Grid>
            <!-- ===== 氛围底：专辑封面模糊 + 明暗蒙层 + 平台双色调 ===== -->
            <Border IsVisible="{Binding HasCover}" Margin="-60">
                <Border.Background>
                    <ImageBrush Source="{Binding Cover}" Stretch="UniformToFill" />
                </Border.Background>
                <Border.Effect>
                    <BlurEffect Radius="60" />
                </Border.Effect>
            </Border>
            <Border Background="{DynamicResource AmbientVeil}" />
            <Border Background="{Binding AccentTintGradient}" />

            <StackPanel Margin="16,16,16,12" Spacing="14">
                <!-- ===== 头部：封面 + 半露唱片 / 歌曲信息 ===== -->
                <Grid ColumnDefinitions="Auto,*">
                    <Grid Width="120" Height="92" VerticalAlignment="Top">
                        <!-- 唱片：从封面右侧露出，中心是同一张封面 -->
                        <Grid Width="84" Height="84" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Fill="#17181C" />
                            <Ellipse Width="76" Height="76" Stroke="#1FFFFFFF" StrokeThickness="0.5" />
                            <Ellipse Width="64" Height="64" Stroke="#17FFFFFF" StrokeThickness="0.5" />
                            <Ellipse Width="52" Height="52" Stroke="#1FFFFFFF" StrokeThickness="0.5" />
                            <Ellipse Width="84" Height="84">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                        <GradientStop Color="#26FFFFFF" Offset="0" />
                                        <GradientStop Color="#00FFFFFF" Offset="0.45" />
                                        <GradientStop Color="#14FFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="30" Height="30" IsVisible="{Binding HasAvatar}">
                                <Ellipse.Fill>
                                    <ImageBrush Source="{Binding Avatar}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="30" Height="30" IsVisible="{Binding !HasAvatar}" Fill="{Binding AccentGradient}" />
                            <Ellipse Width="5" Height="5" Fill="#17181C" />
                        </Grid>
                        <!-- 封面 -->
                        <Grid Width="92" Height="92" HorizontalAlignment="Left">
                            <Border CornerRadius="12" BoxShadow="0 6 18 0 #2E000000" Background="{DynamicResource CoverEmpty}" />
                            <Border CornerRadius="12" ClipToBounds="True" IsVisible="{Binding HasAvatar}">
                                <Image Source="{Binding Avatar}" Stretch="UniformToFill" />
                            </Border>
                            <Border CornerRadius="12" IsVisible="{Binding !HasAvatar}" Background="{Binding AccentSoftGradient}">
                                <Path Data="{Binding Source={x:Static card:MediaCardIcons.Music}, Converter={x:Static card:MediaCardGeometryConverter.Instance}}"
                                      Fill="{Binding AccentGradient}" Stretch="Uniform" Width="30" Height="30" />
                            </Border>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="4">
                        <!-- 平台 | 时长 -->
                        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,0,2">
                            <Border Width="16" Height="16" CornerRadius="8" Background="{Binding BadgeBrush}">
                                <Path Data="{Binding Source={x:Static card:MediaCardIcons.NetEase}, Converter={x:Static card:MediaCardGeometryConverter.Instance}}"
                                      Fill="#FFFFFF" Stretch="Uniform" Width="10" Height="10" />
                            </Border>
                            <TextBlock Text="网易云音乐" Foreground="{DynamicResource TextMeta}" FontSize="9.5"
                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Width="1" Height="9" Background="{DynamicResource TextMeta}" Opacity="0.4"
                                    VerticalAlignment="Center" Margin="1,0" IsVisible="{Binding HasDuration}" />
                            <TextBlock Text="{Binding DurationText}" IsVisible="{Binding HasDuration}"
                                       Foreground="{DynamicResource TextMeta}" FontSize="9.5" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextTitle}"
                                   FontSize="16" FontWeight="Bold" LineHeight="21" TextWrapping="Wrap"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Artists}" Foreground="{DynamicResource TextArtist}"
                                   FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasAlbum}">
                            <Path Data="{Binding Source={x:Static card:MediaCardIcons.Album}, Converter={x:Static card:MediaCardGeometryConverter.Instance}}"
                                  Fill="{DynamicResource TextMeta}" Stretch="Uniform" Width="8.5" Height="8.5"
                                  VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Album}" Foreground="{DynamicResource TextMeta}" FontSize="9.5"
                                       MaxWidth="150" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ===== 歌词 ===== -->
                <Border Classes="glassPanel" Padding="14,12,14,6">
                    <StackPanel Spacing="9">
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Path Data="{Binding Source={x:Static card:MediaCardIcons.Waveform}, Converter={x:Static card:MediaCardGeometryConverter.Instance}}"
                                      Fill="{Binding AccentGradient}" Stretch="Uniform" Width="11" Height="11"
                                      VerticalAlignment="Center" />
                                <TextBlock Text="歌词" Foreground="{DynamicResource TextTitle}" FontSize="11"
                                           FontWeight="Bold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Credits}" IsVisible="{Binding HasCredits}"
                                       Foreground="{DynamicResource TextMeta}" FontSize="9" Margin="10,0,0,0"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <!-- 末尾渐隐，暗示歌词未完 -->
                        <ItemsControl ItemsSource="{Binding Lyrics}" IsVisible="{Binding HasLyrics}">
                            <ItemsControl.OpacityMask>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                                    <GradientStop Color="#FFFFFFFF" Offset="0.72" />
                                    <GradientStop Color="#1AFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </ItemsControl.OpacityMask>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NetEaseLyricLine">
                                    <StackPanel Spacing="1" Margin="0,0,0,7">
                                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextLyric}"
                                                   FontSize="11.5" FontWeight="Medium" LineHeight="17" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Translation}" IsVisible="{Binding HasTranslation}"
                                                   Foreground="{DynamicResource TextTranslation}" FontSize="9.5"
                                                   LineHeight="14" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding EmptyLyricText}" IsVisible="{Binding HasNoLyrics}"
                                   Foreground="{DynamicResource TextMeta}" FontSize="11" FontStyle="Italic"
                                   HorizontalAlignment="Center" Margin="0,6,0,12" />
                    </StackPanel>
                </Border>

                <!-- ===== 底部：回复提示 / 署名 ===== -->
                <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                    <!-- 回复提示：与歌词区同款半透明小胶囊 -->
                    <Border IsVisible="{Binding HasReplyHint}" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Background="{DynamicResource PanelBg}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="7,3,9,3">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="{Binding Source={x:Static card:MediaCardIcons.Download}, Converter={x:Static card:MediaCardGeometryConverter.Instance}}"
                                  Fill="{Binding AccentGradient}" Stretch="Uniform" Width="10" Height="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ReplyHint}" Foreground="{DynamicResource TextMeta}" FontSize="9"
                                       FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <card:CardBrandMark Grid.Column="1" TextSize="8" Opacity="0.8" Margin="8,0,0,0"
                                        TextElement.Foreground="{DynamicResource BrandText}" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
