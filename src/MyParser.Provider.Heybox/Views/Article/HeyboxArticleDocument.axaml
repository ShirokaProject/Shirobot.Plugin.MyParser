<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MyParser.Provider.Heybox.Views"
             xmlns:cr="using:Shirobot.Plugin.MyParser.CardRendering"
             x:Class="MyParser.Provider.Heybox.Views.HeyboxArticleDocument"
             x:DataType="vm:HeyboxArticleDocumentViewModel"
             Width="640"
             HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">

    <Design.DataContext>
        <vm:HeyboxArticleDocumentViewModel />
    </Design.DataContext>

    <!-- 阅读排版：正文宽 560；字号 28 标题 / 19–22 小标题 / 16 正文 / 12 说明。配色与小黑盒卡片一致 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Page" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Placeholder" Color="#EEF1F4" />
                    <SolidColorBrush x:Key="Divider" Color="#ECEFF2" />
                    <SolidColorBrush x:Key="TextTitle" Color="#14191E" />
                    <SolidColorBrush x:Key="TextBody" Color="#2B343E" />
                    <SolidColorBrush x:Key="TextMeta" Color="#8A94A0" />
                    <SolidColorBrush x:Key="Accent" Color="#00A3D9" />
                    <SolidColorBrush x:Key="QuoteBg" Color="#F3F8FB" />
                    <SolidColorBrush x:Key="TopicBg" Color="#E6F6FC" />
                    <SolidColorBrush x:Key="TopicText" Color="#0083AF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Page" Color="#24282F" />
                    <SolidColorBrush x:Key="Placeholder" Color="#2F343C" />
                    <SolidColorBrush x:Key="Divider" Color="#343941" />
                    <SolidColorBrush x:Key="TextTitle" Color="#F2F5F7" />
                    <SolidColorBrush x:Key="TextBody" Color="#D3DAE1" />
                    <SolidColorBrush x:Key="TextMeta" Color="#97A2AE" />
                    <SolidColorBrush x:Key="Accent" Color="#2FC6F0" />
                    <SolidColorBrush x:Key="QuoteBg" Color="#2B3038" />
                    <SolidColorBrush x:Key="TopicBg" Color="#1E3A45" />
                    <SolidColorBrush x:Key="TopicText" Color="#6FD8F5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource Page}">
        <StackPanel>
            <!-- ===== 封面横幅 ===== -->
            <Border Height="240" ClipToBounds="True" Background="{DynamicResource Placeholder}" IsVisible="{Binding HasCover}">
                <Image Source="{Binding Cover}" Stretch="UniformToFill" />
            </Border>

            <StackPanel Margin="40,28,40,0" Spacing="16">
                <!-- 平台与类型 -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Accent}">
                        <Viewbox Width="13" Height="13">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Source={x:Static vm:HeyboxIcons.Brand}, Converter={x:Static cr:MediaCardGeometryConverter.Instance}}" Fill="White" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="小黑盒" Foreground="{DynamicResource TextBody}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="·" Foreground="{DynamicResource TextMeta}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource TextMeta}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextTitle}" FontSize="28" FontWeight="Bold"
                           LineHeight="38" TextWrapping="Wrap" />

                <!-- 作者 -->
                <Grid ColumnDefinitions="Auto,*">
                    <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True" Background="{DynamicResource Placeholder}">
                        <Panel>
                            <Image Source="{Binding Avatar}" Stretch="UniformToFill" IsVisible="{Binding HasAvatar}" />
                            <TextBlock Text="{Binding AvatarInitial}" IsVisible="{Binding HasNoAvatar}" Foreground="{DynamicResource TextMeta}"
                                       FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding AuthorName}" Foreground="{DynamicResource TextTitle}" FontSize="14" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding MetaText}" Foreground="{DynamicResource TextMeta}" FontSize="12" />
                    </StackPanel>
                </Grid>

                <!-- 话题 -->
                <ItemsControl ItemsSource="{Binding Topics}" IsVisible="{Binding HasTopics}" Margin="0,0,0,-6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Border Background="{DynamicResource TopicBg}" CornerRadius="4" Padding="9,3" Margin="0,0,6,6">
                                <TextBlock Text="{Binding StringFormat='#{0}'}" Foreground="{DynamicResource TopicText}" FontSize="12" FontWeight="Medium" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Height="1" Background="{DynamicResource Divider}" />

                <!-- ===== 正文 ===== -->
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HeyboxArticleBlockViewModel">
                            <Panel>
                                <TextBlock IsVisible="{Binding IsParagraph}" Text="{Binding Text}" Foreground="{DynamicResource TextBody}"
                                           FontSize="16" LineHeight="28" TextWrapping="Wrap" />

                                <!-- 小标题：左侧短色条 -->
                                <Grid IsVisible="{Binding IsHeading}" ColumnDefinitions="Auto,*" Margin="0,6,0,0">
                                    <Border Width="4" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,4,10,4" />
                                    <TextBlock Grid.Column="1" Text="{Binding Text}" Foreground="{DynamicResource TextTitle}"
                                               FontSize="{Binding HeadingSize}" FontWeight="Bold" LineHeight="30" TextWrapping="Wrap" />
                                </Grid>

                                <!-- 引用 -->
                                <Border IsVisible="{Binding IsQuote}" Background="{DynamicResource QuoteBg}" CornerRadius="4"
                                        BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0" Padding="14,10">
                                    <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBody}" FontSize="15" LineHeight="25"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- 图片 -->
                                <StackPanel IsVisible="{Binding IsImage}" Spacing="6">
                                    <Border CornerRadius="4" ClipToBounds="True" Width="{Binding ImageWidth}" Height="{Binding ImageHeight}"
                                            HorizontalAlignment="Center" Background="{DynamicResource Placeholder}">
                                        <Panel>
                                            <!-- 竖图：同一张图模糊放大铺满背景，再压一层暗色，原图完整居中 -->
                                            <Image Source="{Binding Image}" Stretch="UniformToFill" IsVisible="{Binding HasBackdrop}" Margin="-24">
                                                <Image.Effect>
                                                    <BlurEffect Radius="70" />
                                                </Image.Effect>
                                            </Image>
                                            <Border Background="#4D000000" IsVisible="{Binding HasBackdrop}" />
                                            <Image Source="{Binding Image}" Stretch="Uniform" />
                                        </Panel>
                                    </Border>
                                    <TextBlock IsVisible="{Binding HasCaption}" Text="{Binding Caption}" Foreground="{DynamicResource TextMeta}"
                                               FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- 视频：不能内嵌播放，给出链接 -->
                                <Border IsVisible="{Binding IsVideo}" Background="{DynamicResource QuoteBg}" CornerRadius="4" Padding="12,10">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="{Binding Source={x:Static vm:HeyboxIcons.Videos}, Converter={x:Static cr:MediaCardGeometryConverter.Instance}}"
                                                      Fill="{DynamicResource Accent}" />
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                                            <TextBlock Text="视频" Foreground="{DynamicResource TextTitle}" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextMeta}" FontSize="11"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Panel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- ===== 互动与底部 ===== -->
            <Border Height="1" Background="{DynamicResource Divider}" Margin="40,24,40,0" />
            <ItemsControl ItemsSource="{Binding Stats}" IsVisible="{Binding HasStats}" Margin="40,14,40,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:HeyboxStat">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <Viewbox Width="17" Height="17" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{Binding Icon, Converter={x:Static cr:MediaCardGeometryConverter.Instance}}" Fill="{DynamicResource TextMeta}" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextBody}" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="Auto,*" Margin="40,16,40,20">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="小黑盒 · heybox" Foreground="{DynamicResource TextMeta}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
                <cr:CardBrandMark Grid.Column="1" TextSize="10" VerticalAlignment="Center"
                                  TextElement.Foreground="{DynamicResource TextMeta}" />
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
